{
  "name": "hands3dlab-voxkit",
  "productName": "Hands3DLab-VoxKit",
  "version": "0.1.0",
  "description": "Hands3DLab voxelization desktop app",
  "main": "src/main.cjs",
  "build": {
    "productName": "Hands3DLab-VoxKit",
    "mac": {
      "icon": "assets/AppIcon.icns"
    },
    "win": {
      "icon": "assets/AppIcon.ico"
    },
    "asar": true,
    "files": [
      "**/*",
      "!config.toml",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": ".protected/voxkit-config.enc.json",
        "to": "voxkit-config.enc.json"
      }
    ]
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "protect:mac": "node scripts/protect-resources.cjs darwin",
    "protect:win": "node scripts/protect-resources.cjs win32",
    "protect:linux": "node scripts/protect-resources.cjs linux",
    "build": "cmake -S .. -B ../build -DCMAKE_BUILD_TYPE=Release && cmake --build ../build --parallel 2",
    "package:mac": "npm run protect:mac && electron-builder --mac",
    "package:win": "npm run protect:win && electron-builder --win",
    "package:linux": "npm run protect:linux && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  }
}
